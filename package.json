{
  "name": "mailmoat",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI email assistant that phishing can't talk into anything.",
  "license": "MIT",
  "author": "Kaushal Shahare",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/main.js",
    "build": "npm run build -w web",
    "dev:web": "npm run dev -w web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "connect:google": "node --env-file-if-exists=.env server/scripts/connect-google.js",
    "dev:sync": "node --env-file-if-exists=.env server/scripts/dev-sync.js",
    "llm:smoke": "node --env-file-if-exists=.env server/scripts/llm-smoke.js",
    "reader:sample": "node --env-file-if-exists=.env server/scripts/reader-sample.js",
    "attack-lab": "node --env-file-if-exists=.env server/test/attack-lab/run.js",
    "demo": "node server/test/attack-lab/demo.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
