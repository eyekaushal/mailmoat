# Optional developer overrides. Values saved in the app's Settings page take precedence.
# Copy to .env (gitignored) — never commit real values.

# Anthropic API key (your own; https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google OAuth client. Normally not needed: mailmoat ships a built-in client
# (server/src/config/builtInGoogleClient.js). Set these only to use your own
# Google Cloud project ("Desktop app" type) during development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local server port (binds to 127.0.0.1 only)
PORT=4747
